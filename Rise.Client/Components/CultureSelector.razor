@using System.Globalization
@inject IJSRuntime JS
@inject NavigationManager Navigation

@using MudBlazor

<MudMenu StartIcon="@Icons.Material.Filled.Translate" EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
    Label="@selectedCulture?.DisplayName" Color="Color.Secondary">
    @foreach (var culture in supportedCultures)
    {
        <MudMenuItem @onclick="async () => await OnCultureSelectedAsync(culture)">
            @culture.DisplayName
        </MudMenuItem>
    }
    </MudMenu>
