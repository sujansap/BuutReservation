@using MudBlazor
@using Rise.Client.Components
@using Microsoft.Extensions.Localization
@using Rise.Client.Localization

@inject IStringLocalizer<LandingPageResource> Localizer

<MudAppBar Elevation="1">

    @* Always display *@
    <MudLink Href="/" data-testid="nav-brand-logo">
        <MudImage Src="assets/BUUT_logo_white.webp" Alt="buut logo" Height="60" Width="60" ObjectFit="ObjectFit.Contain"
            Class="mr-3" />
    </MudLink>

    @* NavMenu for desktop *@
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudStack Row="true">
            <MudNavLink Href="counter" data-testid="nav-desktop-counter">@Localizer["Home"]</MudNavLink>
            <MudNavLink Href="about" data-testid="nav-desktop-about">@Localizer["About"]</MudNavLink>
            <MudNavLink Href="reservations" data-testid="nav-desktop-reservations">@Localizer["Reserve"]</MudNavLink>
        </MudStack>
        <MudSpacer></MudSpacer>
        <MudButton Class="mr-4" Variant="Variant.Filled" Size="Size.Medium" Color="Color.Secondary" Href="book"
            data-testid="nav-desktop-book">
            @Localizer["BookNow"]
        </MudButton>
        <MudIconButton Class="mr-2" Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" Edge="Edge.End"
            Href="profile" data-testid="nav-desktop-profile" />
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Edge="Edge.End"
            Href="notifications" data-testid="nav-desktop-notifications" />

        <CultureSelector MenuColor="Color.Secondary" />
    </MudHidden>

    @* NavMenu for mobile *@
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudSpacer></MudSpacer>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
            OnClick="@ToggleDrawer" data-testid="nav-drawer-open-button" />
    </MudHidden>

</MudAppBar>

<MudDrawer @bind-Open="@_drawerOpen" Elevation="1" Variant="@DrawerVariant.Temporary" Anchor="Anchor.End">
    <MudDrawerHeader Class="pr-0">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudAvatar Size="Size.Large" Color="Color.Primary" Variant="Variant.Outlined">B</MudAvatar>
            <MudText>@string.Format(Localizer["WelcomeMessage"], "Bindo")</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Edge="Edge.End"
                OnClick="@ToggleDrawer" data-testid="nav-drawer-close-button" />
        </MudStack>
    </MudDrawerHeader>
    <MudNavMenu>
        <MudDivider />
        <MudNavLink Href="counter" data-testid="nav-mobile-counter" Match="NavLinkMatch.All">@Localizer["Home"]
        </MudNavLink>
        <MudNavLink Href="about" data-testid="nav-mobile-about">@Localizer["About"]</MudNavLink>
        <MudNavLink Href="book" data-testid="nav-mobile-book">@Localizer["BookNow"]</MudNavLink>
        <MudNavLink Href="reservations" data-testid="nav-mobile-reservations">@Localizer["Reserve"]</MudNavLink>
        <MudDivider />
        <MudNavLink Href="profile" data-testid="nav-mobile-profile" Icon="@Icons.Material.Filled.Person">
            @Localizer["Profile"]
        </MudNavLink>
        <MudNavLink Href="notifications" data-testid="nav-mobile-notifications"
            Icon="@Icons.Material.Filled.Notifications">@Localizer["Notifications"]</MudNavLink>





    </MudNavMenu>
    <MudDivider />
    <CultureSelector MenuColor="Color.Inherit" />
</MudDrawer>
