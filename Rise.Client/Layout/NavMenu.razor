@using MudBlazor

<MudAppBar Elevation="1">

    @* Always display *@
    <MudLink Href="/">
        <MudImage Src="assets/BUUT_logo_white.webp" Alt="buut logo" Height="60" Width="60" ObjectFit="ObjectFit.Contain"
            Class="mr-3" />
    </MudLink>

    @* NavMenu for desktop *@
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudStack Row="true">
            <MudNavLink Href="counter">HOME</MudNavLink>
            <MudNavLink Href="about">ABOUT</MudNavLink>
            <MudNavLink Href="reservations">RESERVEER</MudNavLink>
        </MudStack>
        <MudSpacer></MudSpacer>
        <MudButton Class="mr-4" Variant="Variant.Filled" Size="Size.Medium" Color="Color.Secondary" Href="reservations">
            BOOK NOW
        </MudButton>
        <MudIconButton Class="mr-2" Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" Edge="Edge.End"
            Href="profile" />
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Edge="Edge.End"
            Href="notifications" />
    </MudHidden>

    @* NavMenu for mobile *@
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudSpacer></MudSpacer>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
            OnClick="@ToggleDrawer" />
    </MudHidden>

</MudAppBar>

<MudDrawer @bind-Open="@_drawerOpen" Elevation="1" Variant="@DrawerVariant.Temporary" Anchor="Anchor.End">
    <MudDrawerHeader Class="pr-0">
        @* <MudImage Src="assets/BUUT_logo.webp" Alt="buut logo" Height="60" Width="60" ObjectFit="ObjectFit.Contain" />
        *@

        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudAvatar Size="Size.Large" Color="Color.Primary" Variant="Variant.Outlined">B</MudAvatar>
            <MudText>Welkom, Bindo</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Edge="Edge.End"
                OnClick="@ToggleDrawer" />
        </MudStack>
    </MudDrawerHeader>
    <MudNavMenu>
        <MudDivider />
        <MudNavLink Href="counter" Match="NavLinkMatch.All">HOME</MudNavLink>
        <MudNavLink Href="about">ABOUT</MudNavLink>
        <MudNavLink Href="book">BOOK NOW</MudNavLink>
        <MudNavLink Href="reservations">RESERVEER</MudNavLink>
        <MudDivider />
        <MudNavLink Href="profile" Icon="@Icons.Material.Filled.Person">Profile</MudNavLink>
        <MudNavLink Href="notifications" Icon="@Icons.Material.Filled.Notifications">Notifications</MudNavLink>
    </MudNavMenu>
</MudDrawer>
