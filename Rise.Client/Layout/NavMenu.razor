@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject NavigationManager Navigation

<MudAppBar Elevation="1">

    @* Always display *@
    <MudLink Href="/" data-testid="nav-brand-logo">
        <MudImage Src="assets/BUUT_logo_white.webp" Alt="buut logo" Height="60" Width="60" ObjectFit="ObjectFit.Contain"
            Class="mr-3" />
    </MudLink>

    @* NavMenu for desktop *@
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudNavLink Href="counter" data-testid="nav-desktop-counter">HOME</MudNavLink>
            <MudNavLink Href="about" data-testid="nav-desktop-about">ABOUT</MudNavLink>
            <MudNavLink Href="reservations" data-testid="nav-desktop-reservations">RESERVEER</MudNavLink>
        </MudStack>
        <MudSpacer></MudSpacer>
        <MudButton Class="mr-8" Variant="Variant.Filled" Size="Size.Medium" Color="Color.Secondary" Href="book"
            data-testid="nav-desktop-book">
            BOOK NOW
        </MudButton>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"
            StretchItems="StretchItems.Start">
            <AuthorizeView>
                <Authorized>
                    <MudButton Href="profile" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Person"
                        Color="Color.Inherit" data-testid="nav-desktop-profile">
                        @context.User.Identity?.Name
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Edge="Edge.End"
                        Href="notifications" data-testid="nav-desktop-notifications" />
                    <MudNavLink OnClick="BeginLogOut" data-testid="nav-desktop-logout"
                        Icon="@Icons.Material.Filled.Logout" IconColor="Color.Inherit">
                        Log out
                    </MudNavLink>
                </Authorized>
                <NotAuthorized>
                    <MudNavLink Href="authentication/login" data-testid="nav-desktop-login"
                        Icon="@Icons.Material.Filled.Login">Log in
                    </MudNavLink>
                </NotAuthorized>
            </AuthorizeView>
        </MudStack>
    </MudHidden>

    @* NavMenu for mobile *@
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudSpacer></MudSpacer>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
            OnClick="@ToggleDrawer" data-testid="nav-drawer-open-button" />
    </MudHidden>

</MudAppBar>

<MudDrawer @bind-Open="@_drawerOpen" Elevation="1" Variant="@DrawerVariant.Temporary" Anchor="Anchor.End">
    <MudDrawerHeader Class="pr-0">
        @* TODO make mobile profile *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <AuthorizeView>
                <Authorized>
                    <MudAvatar Size="Size.Large" Color="Color.Primary" Variant="Variant.Outlined">
                        @(!string.IsNullOrWhiteSpace(context.User.Identity?.Name) ? context.User.Identity?.Name[0] :
                            '?')</MudAvatar>
                        <MudText>Welkom, @context.User.Identity?.Name</MudText>
                    </Authorized>
                    <NotAuthorized>
                        <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Primary"
                            Href="authentication/login" data-testid="nav-mobile-login">
                            Login
                        </MudButton>
                    </NotAuthorized>
                </AuthorizeView>
                @* TODO dubble ids? *@
            </MudStack>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="@ToggleDrawer"
                data-testid="nav-drawer-close-button" />
        </MudDrawerHeader>
        <MudNavMenu>
            <MudDivider />
            <MudNavLink Href="counter" data-testid="nav-mobile-counter" Match="NavLinkMatch.All">HOME</MudNavLink>
            <MudNavLink Href="about" data-testid="nav-mobile-about">ABOUT</MudNavLink>
            <MudNavLink Href="book" data-testid="nav-mobile-book">BOOK NOW</MudNavLink>
            <MudNavLink Href="reservations" data-testid="nav-mobile-reservations">RESERVEER</MudNavLink>
            <AuthorizeView>
                <Authorized>
                    <MudDivider />
                    <MudNavLink Href="profile" data-testid="nav-mobile-profile" Icon="@Icons.Material.Filled.Person">Profile
                    </MudNavLink>
                    <MudNavLink Href="notifications" data-testid="nav-mobile-notifications"
                        Icon="@Icons.Material.Filled.Notifications">Notifications</MudNavLink>
                    <MudNavLink OnClick="BeginLogOut" data-testid="nav-mobile-logout" Icon="@Icons.Material.Filled.Logout">
                        Log out</MudNavLink>
                </Authorized>
                <NotAuthorized>
                </NotAuthorized>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    @code {
    public void BeginLogOut()
    {
        Navigation.NavigateToLogout("authentication/logout");
    }
}
