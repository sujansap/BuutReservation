@page "/reservations"
@using MudBlazor
@using Rise.Client.Reservations.Components
@using Heron.MudCalendar
@inject NavigationManager Navigation
@inject ISnackbar Snackbar


<MudPopoverProvider />

<PageTitle>Reservaties</PageTitle>

<MudTabs Elevation="0" Centered="true" Class="mb-16">
    <MudTabPanel Text="Reserveer" data-testid="tab-reserve">
        <CustomCalendar ShowTodayButton="true" ShowDay="false" ShowWeek="false" ShowWorkWeek="false" Class="mt-8"
            data-testid="custom-calendar-reserve" Items="AvailableDays" GreyedOutDates="GreyedOutDates"
            DateRangeChanged="OnDateRangeChanged">
            <MonthTemplate>
                <CustomDayComponent Context="context" />
            </MonthTemplate>
        </CustomCalendar>
    </MudTabPanel>
    <MudTabPanel Text="Uw Reservaties" data-testid="tab-your-reservations">
        <MudCalendar ShowDay="false" ShowWeek="false" ShowWorkWeek="false" Class="mt-8"
            data-testid="calendar-your-reservations" />
    </MudTabPanel>
</MudTabs>

<ReservationCalendarLegend data-testid="custom-calendar-legend" />