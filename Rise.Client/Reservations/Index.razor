@page "/reservations"
@using MudBlazor
@using Rise.Client.Reservations.Components
@using Rise.Client.TimeSlots
@using Heron.MudCalendar
@using Rise.Client.Reservations.Components.TimeSlotList
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using Microsoft.Extensions.Localization
@using Rise.Client.Localization.Reservations

@inject IStringLocalizer<ReservationPageResources> Localizer



<PageTitle>Reservaties</PageTitle>

<MudTabs Elevation="0" Centered="true" Class="mb-16">
    <MudTabPanel Text="@Localizer["Reserve"]" data-testid="tab-reserve">
        <MudGrid>
            @* TODO make mobile first *@
            @* TODO margin is messing with tabs *@
            @* TODO calendar is clickable and navigeable to the past *@
            @* TODO everything is clickeable (this is hell) *@
            <MudItem xs="12" md="8">
                <CustomCalendar ShowTodayButton="true" ShowDay="false" ShowWeek="false" ShowWorkWeek="false"
                    Class="mt-8" data-testid="custom-calendar-reserve" GreyedOutDates="GreyedOutDates"
                    DateRangeChanged="OnDateRangeChanged" CellClicked="OnCellClicked">
                    <MonthTemplate>
                        <CustomDayComponent Context="context" />
                    </MonthTemplate>
                </CustomCalendar>
            </MudItem>
            <MudItem xs="12" md="4" Class="mt-8">
                @if (SelectedDate.HasValue)
                {
                    <TimeSlotsList SelectedDate="SelectedDate.Value" />
                }
            </MudItem>
        </MudGrid>

    </MudTabPanel>
    <MudTabPanel Text="@Localizer["YourReservations"]" data-testid="tab-your-reservations">
        <MudCalendar ShowDay="false" ShowWeek="false" ShowWorkWeek="false" Class="mt-8"
            data-testid="calendar-your-reservations" />
    </MudTabPanel>
</MudTabs>

@if (activeTabIndex == 0)
{
    <ReservationCalendarLegend data-testid="custom-calendar-legend" />
}

@code {
    private int activeTabIndex = 0;

    // ... existing code ...
}
