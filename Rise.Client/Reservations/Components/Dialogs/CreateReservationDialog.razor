@using Rise.Shared.TimeSlots;
@using Rise.Shared.Reservations;
@using Rise.Client.Reservations.Components.Dialogs.DialogContent;

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Reservatie maken
        </MudText>
    </TitleContent>
    <DialogContent>
        @switch (State)
        {
            case DialogState.Overview:
                        <CreateReservationOverviewContent Date="@Date" Timeslot="@Timeslot" />
                break;
            case DialogState.Pay:
                        <CreateReservationPaymentContent />
                break;
            case DialogState.Success:
                        <CreatereservationSuccessConent />
                break;

        }
    </DialogContent>
    <DialogActions>
        <MudGrid Justify="Justify.Center" Class="w-100 px-4" Spacing="2">
            @switch (State)
            {
                case DialogState.Overview:
                            <MudItem xs="12">
                                <MudButton Color="Color.Primary" FullWidth="true" OnClick="NextState" Variant="Variant.Filled">
                                    Maak reservatie
                                </MudButton>
                            </MudItem>
                    break;
                case DialogState.Pay:
                            <MudItem xs="12">
                                <MudButton Color="Color.Primary" FullWidth="true" OnClick="NextState" Variant="Variant.Filled">
                                    Bevestig betaling
                                </MudButton>
                            </MudItem>
                    break;
            }
            <MudItem>
                @switch (State)
                {

                    case DialogState.Overview:
                    case DialogState.Pay:
                                <MudButton OnClick="Cancel">
                                    Annuleer
                                </MudButton>
                        break;
                    case DialogState.Success:
                                <MudButton OnClick="Close">
                                    Sluit
                                </MudButton>
                        break;
                }
            </MudItem>
        </MudGrid>
    </DialogActions>
</MudDialog>