@using Rise.Shared.TimeSlots;
@using Rise.Shared.Reservations;

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Reservatie maken
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>
            U staat op het punt een reservatie te maken voor de volgende datum en tijdstip:
        </MudText>
        <MudText Class="mb-8">
            @Date.ToString("D") om @Timeslot?.Start tot @Timeslot?.End
        </MudText>

        <MudForm Class="mb-8" Spacing="4">
            <MudNumericField Label="Aantal volwassenen (inclusief jezelf)" @bind-Value="@Reservation.AmountAdults"
                Required="true" Variant="Variant.Filled" />
            <MudNumericField Label="Aantal kinderen" @bind-Value="@Reservation.AmountChildren" Required="true"
                Variant="Variant.Filled" />
            <MudNumericField Label="Aantal huisdieren" @bind-Value="@Reservation.AmountPets" Required="true"
                Variant="Variant.Filled" />
        </MudForm>

    </DialogContent>
    <DialogActions>
        <MudGrid Justify="Justify.Center" Class="w-100 px-4" Spacing="2">
            <MudItem xs="12">
                <MudButton Color="Color.Primary" FullWidth="true" OnClick="CreateReservation" Variant="Variant.Filled">
                    Maak reservatie
                </MudButton>
            </MudItem>
            <MudItem>
                <MudButton OnClick="Cancel">
                    Annuleer
                </MudButton>
            </MudItem>
        </MudGrid>
    </DialogActions>
</MudDialog>