@using Rise.Shared.TimeSlots;
@using Rise.Client.Reservations.Components.Dialogs;

<MudContainer Class="pa-4">
    <MudStack Spacing="4" AlignItems="AlignItems.Center">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" Size="Size.Large" />

        <MudText Typo="Typo.h5" Color="Color.Primary" Class="text-center">
            Uw reservatie is succesvol aangemaakt
        </MudText>

        <MudPaper Class="pa-4 mt-4" Width="100%">
            <MudStack>
                <MudStack>
                    <MudText Typo="Typo.subtitle2">Datum en Tijdstip:</MudText>
                    <MudText Typo="Typo.h5">@Date.ToString("D")</MudText>
                    <MudText Typo="Typo.h5">@Timeslot?.Start - @Timeslot?.End</MudText>
                </MudStack>

                <MudDivider Class="my-3" />

                <MudStack>
                    <MudText Typo="Typo.subtitle2">Naam</MudText>
                    <MudText>@User.Name</MudText>
                </MudStack>

                <MudDivider Class="my-3" />

                <MudStack>
                    <MudText Typo="Typo.subtitle2">Email</MudText>
                    <MudText>@User.Email</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    [Parameter] public UserDto User { get; set; }
    [Parameter] public DateOnly Date { get; set; }
    [Parameter] public TimeSlotDto? Timeslot { get; set; }
}