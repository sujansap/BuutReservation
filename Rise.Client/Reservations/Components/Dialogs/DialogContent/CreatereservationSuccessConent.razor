@using Rise.Shared.TimeSlots;
@using Rise.Client.Reservations.Components.Dialogs;

<MudText Class="mb-2">Uw reservatie is succesvol aangemaakt</MudText>
<MudText>
    Datum en Tijdstip: @Date.ToString("D") om @Timeslot?.Start tot @Timeslot?.End
</MudText>
<MudText>
    Naam: @User.Name
</MudText>
<MudText Class="mb-8">
    Email: @User.Email
</MudText>

@code {
    [Parameter] public UserDto User { get; set; }
    [Parameter] public DateOnly Date { get; set; }
    [Parameter] public TimeSlotDto? Timeslot { get; set; }
}