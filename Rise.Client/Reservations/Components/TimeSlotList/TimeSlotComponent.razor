@using MudBlazor
@using Rise.Shared.TimeSlots;
@using MudBlazor.Utilities;

<MudStack Class="rounded" Style="@StackStyle">
    <MudText Align="Align.Center" Typo="Typo.subtitle1" Class="mud-text-secondary my-4" Color="@TextColor">
        @Timeslot?.Start.Hours:@(Timeslot?.Start.Minutes.ToString("00")) -
        @Timeslot?.End.Hours:@(Timeslot?.End.Minutes.ToString("00"))
    </MudText>
</MudStack>