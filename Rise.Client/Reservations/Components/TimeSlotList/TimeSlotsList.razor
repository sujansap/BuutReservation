<!-- Pages/TimeslotList.razor -->
@page "/timeslots"
@using Rise.Client.Localization.Reservations
@using Rise.Shared.TimeSlots
@using static System.Net.WebRequestMethods

@using Microsoft.Extensions.Localization


@inject IStringLocalizer<ReservationPageResources> Localizer
<MudPaper Class="pa-2 h-fill" data-testid="time-slot-list">
    <MudText Typo="Typo.h5" Class="mud-text-secondary mb-4">@SelectedDate.ToString("dd MMMM yyyy")</MudText>
    @if (timeSlots == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <p>Loading timeslots...</p>
    }
    else
    {
        if (timeSlots.Count() == 0)
        {
            <MudAlert Severity="Severity.Info">@Localizer["NoTimeSlotAvailable"]</MudAlert>
        }
        else
        {
            <MudStack>
                @foreach (var timeSlot in timeSlots)
                {
                    <TimeSlotComponent TimeSlot="timeSlot" Date="SelectedDate" RefetchData="RefetchData" />

                }
            </MudStack>
        }

    }
</MudPaper>