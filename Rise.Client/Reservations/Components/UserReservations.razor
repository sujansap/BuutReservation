@page "/user-reservations"
@using Rise.Shared.Reservations
@using MudBlazor
@using Rise.Client.Services

<MudGrid Spacing="6" Class="mt-8">
    @if (reservations is null)
    {
        <MudItem xs="12">
            <MudProgressCircular Indeterminate="true" data-testid="loading-progress" />
        </MudItem>
    }
    else if (reservations.Any())
    {
        @foreach (var reservation in reservations)
        {
            <MudItem xs="12">
                <MudCard Elevation="5" Class="mb-6">
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="4" Class="d-flex justify-center align-center" Style="height: 100%;">
                                <!-- Updated icon styling for better centering -->
                                <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Size="Size.Large" Style="width: 80px; height: 80px; color: #40e0d0;" />
                            </MudItem>
                            <MudItem xs="8" Class="d-flex flex-column" Style="padding-left: 20px;">
                                <MudText Typo="Typo.h5" Class="mb-2" data-testid="reservation-date">
                                    Reservation for <strong>@reservation.Date.ToShortDateString()</strong>
                                </MudText>
                                <MudText data-testid="reservation-boat-name">
                                    <strong>Boat:</strong> @reservation.BoatPersonalName
                                </MudText>
                                <MudText data-testid="reservation-time">
                                    <strong>Time:</strong> @reservation.Start - @reservation.End
                                </MudText>
                                <MudItem Class="ml-auto mt-auto">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Style="background-color: #40e0d0;">
                                        View Details
                                    </MudButton>
                                </MudItem>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    }
    else
    {
        <MudItem xs="12">
            <MudText data-testid="no-reservations">No reservations found.</MudText>
        </MudItem>
    }
</MudGrid>

@code {
    private IEnumerable<ReservationDto> reservations;

    protected override async Task OnInitializedAsync()
    {
        await LoadReservations();
    }

    private async Task LoadReservations()
    @* TODO: make new service method work *@
            reservations = await ReservationService.GetUserReservations(1);
    }

    [Inject]
    public IReservationService ReservationService { get; set; }
}
