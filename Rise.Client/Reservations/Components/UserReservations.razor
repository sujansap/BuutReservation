@page "/user-reservations"
@using Rise.Shared.Reservations
@using MudBlazor
@using Rise.Client.Services

<MudGrid Spacing="6" Class="mt-8">
    @if (reservations == null)
    {
        <MudItem xs="12">
            <MudProgressCircular Indeterminate="true" />
        </MudItem>
    }
    else if (reservations.Any())
    {
        @foreach (var reservation in reservations)
        {
            <MudItem xs="12">
                <MudCard Elevation="3" Class="mb-6">
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="4">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large"
                                    Style="width: 100%; height: 200px;" />
                            </MudItem>
                            <MudItem xs="8">
                                <MudText Typo="Typo.h6" Class="mb-4">Reservation for @reservation.Date.ToShortDateString()
                                </MudText>
                                <MudText><strong>Time:</strong> @reservation.Start - @reservation.End</MudText>
                                <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="mt-4">
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Class="mr-2">Cancel
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary">View Details</MudButton>
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    }
    else
    {
        <MudItem xs="12">
            <MudText>No reservations found.</MudText>
        </MudItem>
    }
</MudGrid>

@code {
    private IEnumerable<ReservationDto> reservations;

    protected override async Task OnInitializedAsync()
    {
        await LoadReservations();
    }

    [Inject]
    private IReservationService ReservationService { get; set; } = default!;

    private async Task LoadReservations()
    {
    //TODO: Moet nog geedit user id via token
        @* reservations = await ReservationService.GetCurrentUserReservations(1); *@
    }
}
