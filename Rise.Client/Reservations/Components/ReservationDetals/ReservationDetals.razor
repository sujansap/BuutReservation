@page "/reservations/{Id:int}"
@using Rise.Client.Common.Buttons
@using Rise.Client.Localization.Reservations
@using Rise.Shared.Reservations
@using Microsoft.Extensions.Localization
@using Rise.Client.Common
@attribute [Authorize(Roles = "Member, Administrator")]
@inject IStringLocalizer<ReservationPageResources> Localizer


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-2">
    <div class="d-flex mb-2">
        <BackButton data-testid="reservation-details-back-button" Href="/reservations?CurrentTab=reservations" />
    </div>

    <AsyncData DataFetcher="@GetReservationDetails" @bind-Data="@ReservationDetails" T="ReservationDetailsDto"
        @ref="@AsyncDataRef" TestIdPrefix="reservation-details">
        @if (ReservationDetails != null)
        {
            @if (ReservationDetails.IsDeleted)
            {
                <MudItem xs="12" Class="d-flex justify-center align-center mt-2">
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="rounded-lg"
                        data-testid="cancel-reservation-geannuleerd">
                        @Localizer["DetailsDenied"]
                    </MudAlert>
                </MudItem>
            }
            else
            {
                <MudCard Elevation="3" Class="rounded-lg" Style="min-height: 600px;">
                    <MudCardHeader Class="pb-0">
                        <CardHeaderContent>
                            <MudText Typo="Typo.h4" Class="mb-0" data-testid="reservation-details-title">
                                @Localizer["Reservatie Details:"]
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent Class="pt-2 d-flex flex-column justify-center" Style="min-height: 450px;">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" Class="d-flex justify-center mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Size="Size.Large"
                                    Style="width: 64px; height: 64px; color: #40e0d0;" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudStack Spacing="3" Class="px-4">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Style="color: #666666;">@Localizer["Date"]:</MudText>
                                        <MudText Typo="Typo.h6" data-testid="reservation-date">
                                            @ReservationDetails.Date.ToShortDateString()
                                        </MudText>
                                    </div>

                                    <MudDivider />

                                    <div>
                                        <MudText Typo="Typo.subtitle1" Style="color: #666666;">@Localizer["Boat"]:</MudText>
                                        <MudText Typo="Typo.h6" data-testid="reservation-boat">
                                            @ReservationDetails.BoatPersonalName
                                        </MudText>
                                    </div>

                                    <MudDivider />

                                    <div>
                                        <MudText Typo="Typo.subtitle1" Style="color: #666666;">@Localizer["Time"]:</MudText>
                                        <MudText Typo="Typo.h6" data-testid="reservation-time">
                                            @ReservationDetails.Start - @ReservationDetails.End
                                        </MudText>
                                    </div>

                                    <MudDivider />

                                    <div>
                                        <MudText Typo="Typo.subtitle1" Style="color: #666666;">
                                            @Localizer["PickupPerson"]:
                                        </MudText>
                                        <MudText Typo="Typo.h6" data-testid="reservation-battery-current-user" Style="min-height: 32px;">
                                            @GetDisplayText(ReservationDetails.CurrentBatteryUserName)
                                        </MudText>

                                        <MudText Typo="Typo.subtitle1" Class="mt-2" Style="color: #666666;">
                                            @Localizer["MentorPerson"]:
                                        </MudText>
                                        <MudText Typo="Typo.h6" data-testid="reservation-battery-mentor" Style="min-height: 32px;">
                                            @GetDisplayText(ReservationDetails.MentorName)
                                        </MudText>
                                    </div>

                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>

                    <MudCardActions Class="d-flex justify-end pa-4" Style="min-height: 80px;">
                        @if (!IsReservationInPast)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Large" OnClick="CancelReservation"
                                data-testid="cancel-reservation-button"
                                Style="background-color: #e06540; border-radius: 4px; padding: 8px 32px;"
                                Disabled="@ReservationDetails.IsDeleted">
                                @Localizer["Cancel Reservation"]
                            </MudButton>
                        }
                    </MudCardActions>
                </MudCard>
            }
        }
    </AsyncData>
</MudContainer>