@using MudBlazor.Components
@using System.Reflection.Metadata;

<MudCard @attributes="AdditionalAttributes">
    <MudCardContent>
        <MudStack Row AlignItems="AlignItems.Center">
            <MudIcon Icon="@(GetSeverityIcon())" Color="GetSeverityColor()" Size="Size.Large" />
            <MudStack Spacing="0">
                @if (Title != null || Title != string.Empty)
                {
                    <MudText Typo="Typo.h6">@Title</MudText>
                }

                @if (Message != null || Message != string.Empty)
                {
                    <MudText Typo="Typo.body1">@Message</MudText>
                }
            </MudStack>
            <MudSpacer />
            <MudStack AlignItems="AlignItems.End">
                <MudText Typo="Typo.caption">@(FormatTimeStamp(TimeStamp))</MudText>
                @if (!IsRead)
                {
                    <MudIcon Icon="@CircleIcon" Color="Color.Info" Size="Size.Small" />
                }
            </MudStack>
        </MudStack>
    </MudCardContent>
</MudCard>