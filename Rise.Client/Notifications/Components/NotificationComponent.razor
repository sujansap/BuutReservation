@using MudBlazor.Components
@using System.Reflection.Metadata;
@using Rise.Client.Utils;

<MudCard @attributes="AdditionalAttributes" Class="cursor-pointer" @onclick="HandleClick">
    <MudCardContent>
        <MudStack Row AlignItems="AlignItems.Center" Style="min-height: 100%;">
            <MudIcon Icon="@(GetSeverityIcon())" Color="GetSeverityColor()" Size="Size.Large" />
            <MudStack Spacing="0" Style="min-width: 0">
                @if (Title != null || Title != string.Empty)
                {
                    <MudText Typo="Typo.h6" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@Title
                    </MudText>
                }

                @if (Message != null || Message != string.Empty)
                {
                    <MudText Typo="Typo.body1" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        @Message</MudText>
                }
            </MudStack>
            <MudSpacer />
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                Style="height: 100%; align-self: stretch;" Spacing="1">
                <MudText Typo="Typo.caption">@(TimeStamp.ToRelativeDateString())</MudText>
                @if (!IsRead)
                {
                    <MudIcon Icon="@CircleIcon" Color="Color.Info" Size="Size.Small" />
                }
            </MudStack>
        </MudStack>
    </MudCardContent>
</MudCard>