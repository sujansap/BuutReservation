@using Rise.Shared.Notifications;
<MudStack Class="notifications-list" Spacing="2">
    @foreach (var notification in Notifications)
    {
        <NotificationComponent Title="@notification.Title" Message="@notification.Message"
            Severity="@(GetSeverityFromString(notification.Severity))" TimeStamp="@notification.CreatedAt"
            IsRead="@notification.IsRead" OnClick="@(() => OnNotificationSelected.InvokeAsync(notification))" />
    }
</MudStack>

<style>
    .notifications-list {
        max-height: 600px;
        overflow-y: auto;
        padding: 16px;
    }

    .notifications-list::-webkit-scrollbar {
        width: 8px;
    }

    .notifications-list::-webkit-scrollbar-track {
        background: transparent;
    }

    .notifications-list::-webkit-scrollbar-thumb {
        background-color: rgba(0, 0, 0, 0.2);
        border-radius: 4px;
    }

    .notifications-list::-webkit-scrollbar-thumb:hover {
        background-color: rgba(0, 0, 0, 0.3);
    }
</style>