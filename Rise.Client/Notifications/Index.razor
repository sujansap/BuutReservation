@page "/notifications"
@using Rise.Client.Notifications.Components
@using Rise.Client.Utils;

<MudContainer>
    <MudText Typo="Typo.h4" Class="pb-8">Notifications</MudText>
    <MudGrid>
        <MudItem xs="12" md="6">
            <NotificationsListComponent Notifications="Notifications"
                OnNotificationSelected="HandleNotificationSelected" />
        </MudItem>
        <MudItem xs="12" md="6">
            <NotificationDetailsComponent Notification="SelectedNotification" />
        </MudItem>
    </MudGrid>
</MudContainer>