@page "/admin/cruise_period/{Id:int?}/timeslots"
@using System.Collections.Generic
@using Rise.Client.Common.Buttons
@using Rise.Client.Admins.Components
@using Rise.Client.Localization.Admins
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AdminPageResources> Localizer
@using Rise.Client.Common
@using Rise.Shared.Users
@using Rise.Shared.TimeSlots
@attribute [Authorize(Roles = nameof(UserRole.Administrator))]

@layout AdminLayout

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <AsyncData DataFetcher="@FetchCruisePeriod" @bind-Data="@CruisePeriod" T="CruisePeriodDetailedDto"
        TestIdPrefix="cruise-period-details">
        <MudCard Elevation="3">
            <MudCardHeader>
                <MudStack>
                    <MudText Typo="Typo.h5">Manage Time Slots</MudText>
                    <MudText Typo="Typo.body1" data-testid="cruise-period-name">
                        @(CruisePeriod?.Id == null ? "New Cruise Period" : "Cruise Period")
                    </MudText>
                    <MudStack Row="true">
                        <MudText data-testid="cruise-period-start">
                            @CruisePeriod?.Start
                        </MudText>
                        <MudText data-testid="cruise-period-end">
                          @CruisePeriod?.End
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudCardHeader>

            <MudDivider Class="my-4" />

            <MudCardContent>
                <MudPaper Class="pa-4" Elevation="0">
                    <MudGrid>
                        <MudItem xs="12" sm="5">
                            <MudTimePicker @bind-Time="@StartTime" Label="Start Time" Class="mt-0"
                                PickerVariant="PickerVariant.Dialog" />
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudTimePicker @bind-Time="@EndTime" Label="End Time" Class="mt-0"
                                PickerVariant="PickerVariant.Dialog" />
                        </MudItem>
                        <MudItem xs="12" sm="2" Class="d-flex align-center">
                            <PrimaryButton Disabled="@(!CanAddTimeSlot)" OnClick="AddTimeSlot" Class="ml-auto">
                                Add
                            </PrimaryButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudDivider Class="my-6" />

                <MudText Typo="Typo.h6" Class="mb-4">Fixed Daily Time Slots</MudText>

                @if (!TimeSlots.Any())
                {
                    <MudAlert Severity="Severity.Info" Elevation="0">
                        No time slots have been added yet
                    </MudAlert>
                }
                else
                {
                    <MudPaper Class="pa-4" Elevation="0">
                        <MudList Dense="true" Clickable="true" T="TimeOnly">
                            @foreach (var timeSlot in TimeSlots.OrderBy(t => t.Start))
                            {
                                <MudListItem>
                                    <div class="d-flex justify-space-between align-center w-100">
                                        <div class="d-flex gap-3 align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                                            <MudText>@timeSlot.Start.ToString("HH:mm") -
                                                @timeSlot.End.ToString("HH:mm")</MudText>
                                        </div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                            OnClick="@(() => RemoveTimeSlot(timeSlot))" />
                                    </div>
                                </MudListItem>
                                <MudDivider Class="my-2" />
                            }
                        </MudList>
                    </MudPaper>
                }
            </MudCardContent>

            <MudCardActions Class="d-flex justify-end pa-4">
                <PrimaryButton Disabled="@(!TimeSlots.Any())" OnClick="SaveTimeSlots">
                    Save Time Slots
                </PrimaryButton>
            </MudCardActions>
        </MudCard>
    </AsyncData>
</MudContainer>