@page "/timeslot-manager"
@using System.Collections.Generic;
@using Rise.Client.Common.Buttons

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudCard Elevation="3">
        <MudCardHeader>
            <MudStack>
                <MudText Typo="Typo.h5">Manage Time Slots</MudText>
            </MudStack>
        </MudCardHeader>

        <MudDivider Class="my-4" />

        <MudCardContent>
            <MudPaper Class="pa-4" Elevation="0">
                <MudGrid>
                    <MudItem xs="12" sm="5">
                        <MudTimePicker @bind-Time="@StartTime" Label="Start Time" Class="mt-0"
                            PickerVariant="PickerVariant.Dialog" />
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudTimePicker @bind-Time="EndTime" Label="End Time" Class="mt-0"
                            PickerVariant="PickerVariant.Dialog" />
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="d-flex align-center">
                        <PrimaryButton Disabled="@(!CanAddTimeSlot)" OnClick="AddTimeSlot" Class="ml-auto">
                            Add
                        </PrimaryButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudDivider Class="my-6" />

            <MudText Typo="Typo.h6" Class="mb-4">Fixed Daily Time Slots</MudText>

            @if (!TimeSlots.Any())
            {
                <MudAlert Severity="Severity.Info" Elevation="0">
                    No time slots have been added yet
                </MudAlert>
            }
            else
            {
                <MudPaper Class="pa-4" Elevation="0">
                    <MudList Dense="true" Clickable="true" T="TimeSpan">
                        @foreach (var timeSlot in TimeSlots.OrderBy(t => t.Start))
                        {
                            <MudListItem>
                                <div class="d-flex justify-space-between align-center w-100">
                                    <div class="d-flex gap-3 align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                                        <MudText>@(new DateTime().Add(timeSlot.Start).ToString("HH:mm")) - @(new
                                    DateTime().Add(timeSlot.End).ToString("HH:mm"))</MudText>
                                        </div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                            OnClick="@(() => RemoveTimeSlot(timeSlot))" />
                                    </div>
                                </MudListItem>
                            <MudDivider Class="my-2" />
                        }
                    </MudList>
                </MudPaper>
            }
        </MudCardContent>

        <MudCardActions Class="d-flex justify-end pa-4">
            <PrimaryButton Disabled="@(!TimeSlots.Any())" OnClick="SaveTimeSlots">
                Save Time Slots
            </PrimaryButton>
        </MudCardActions>
    </MudCard>
</MudContainer>