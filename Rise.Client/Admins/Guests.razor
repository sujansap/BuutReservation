@page "/admin/guests"
@using MudBlazor
@using Rise.Client.Localization.Admins;
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AdminPageResources> Localizer
@using static System.Net.WebRequestMethods
@using Rise.Client.Common
@using Rise.Shared.Users

@layout AdminLayout


<MudPaper Class="pa-2 h-fill" data-testid="user-list">
    <MudText Typo="Typo.h5" Class="mud-text-secondary mb-4">@Localizer["GuestUsers"]</MudText>
    <AsyncData DataFetcher="@FetchUsers" @bind-Data="@Users" T="IEnumerable<UserDto>" @ref="AsyncDataRef"
        ShowContentWhenError="@false" TestIdPrefix="user-list">
        @if (!Users.Any())
        {
            <MudAlert Severity="Severity.Info" data-testid="users-none">@Localizer["NoUsersAvailable"]</MudAlert>
        }
        else
        {
            <MudStack>
                @foreach (UserDto? user in Users)
                {
                    <MudPaper Class="pa-3" Elevation="0">
                        <MudText>@user.FamilyName</MudText>
                    </MudPaper>
                }
            </MudStack>
        }
    </AsyncData>
</MudPaper>